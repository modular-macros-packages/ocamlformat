(** Template applications in paths, in a signature. *)

module type S = sig
  type t

  val mk : int -> t
end

module F : $(X : S) -> sig
  type t = X.t list

  val mk : int -> t
end

module H : $(X : S) -> (Y : S) -> sig
  type t = X.t * Y.t

  val mk : int -> t
end

module M : S with type t = int
module N : S with type t = int

(** Values whose types go through applications of both kinds. *)

val u : F$(M).t
val v : G(M).t
val w : H$(M)(N).t -> F$(H$(M)(N)).t
val nested : F$(F$(M)).t list

(** A module declared by a module type path, and a template whose result
    mentions a path through its own parameter. *)

module A : F$(M).S

module K : $(X : S) -> sig
  type t = F$(X).t

  val same : t -> F$(X).t
end

(** Opens and module substitutions take a module path, so a template application
    is legal there too. *)

open F$(M)
module P := F$(M)

module type Subst = sig
  module Y : S
end
with module Y := F$(M)

(** Types, classes and extensions. *)

type t = private F$(M).t
type k = F$(M).k = A | B of G(M).t

class type c = object
  method get : F$(M).t
end

type F$(M).ext += Extension of H$(M)(N).t

val long :
  A_template_with_a_rather_long_name$(An_argument_with_a_rather_long_name).t ->
  Another_template$(With_an_argument)(And_another).t
(** A docstring on a declaration whose type breaks. *)
